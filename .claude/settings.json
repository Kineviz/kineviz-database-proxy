{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(uv run pytest *)",
      "Bash(uv run python -m pytest *)",
      "Bash(uv pip list *)",
      "Bash(uv --version)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git ls-files *)",
      "Bash(git stash list *)",
      "Bash(git add *)",
      "Bash(npm run build *)",
      "Bash(npm test *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run verify *)",
      "Bash(npm run install:frontend *)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr *)",
      "Bash(npm publish *)",
      "Bash(uv publish *)",
      "Bash(docker push *)",
      "Bash(uv run python scripts/publish.py *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./config/projects.json)",
      "Read(./config/settings.json)",
      "Read(./config/credentials.json)",
      "Read(./config/service-account.json)",
      "Read(./config/*credentials*.json)",
      "Read(./config/*oauth*.json)",
      "Edit(./.env)",
      "Edit(./config/projects.json)",
      "Edit(./config/settings.json)",
      "Edit(./config/credentials.json)",
      "Edit(./config/service-account.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-commit-message.js\"",
            "if": "Bash(git commit *)",
            "timeout": 10,
            "statusMessage": "Checking commit message language"
          }
        ]
      }
    ]
  }
}
