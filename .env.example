# Kineviz Database Proxy Environment Configuration
#
# Copy this file to .env and modify as needed.
# The proxy loads .env automatically on startup.

# =============================================================================
# Authentication (IMPORTANT for production)
# =============================================================================

# Admin Password Authentication (optional)
# Set to require login for the management UI (project management, settings, etc.)
# When set, users must login with this password to access the admin interface.
# Leave unset or empty to allow unrestricted access to the management UI.
# IMPORTANT: Set this when exposing the server to the internet!
# ADMIN_PASSWORD=your-secure-admin-password-here

# API Key Authentication (optional)
# Set to enable API key authentication for database query endpoints.
# External applications (like GraphXR) must include X-API-Key header.
# Can also be configured via the Settings page in the management UI.
# Leave unset or empty to disable API key authentication.
# API_KEY=your-secure-api-key-here

# =============================================================================
# Google Cloud Configuration
# =============================================================================

# Path to service account JSON file (alternative to uploading via UI)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Default GCP project ID
# GOOGLE_CLOUD_PROJECT=your-project-id

# =============================================================================
# Development Configuration (for local development only)
# =============================================================================

# Frontend dev server URL (used when running webpack dev server separately)
# FRONTEND_URL=http://localhost:3002

# Enable debug mode
# DEBUG=true
# =============================================================================
# Graph schema cache
# =============================================================================

# How long a /graphSchema answer is reused before the store is probed again.
# The probe is the expensive part of the graph endpoints on every backend, and a
# schema changes about as often as someone alters a table. Set to 0 to disable
# the cache; pass ?refresh=true on the endpoint for a one-off re-probe.
# GRAPH_SCHEMA_CACHE_TTL_SECONDS=60

# =============================================================================
# Embedded stores (Kuzu / Ladybug)
# =============================================================================
# A store's header names the engine build that can open it, and the proxy fetches
# that build on demand. See doc/EMBEDDED_STORES.md.

# Where engine builds are installed. Each release gets its own directory and its
# own process: two builds of these engines cannot share one interpreter.
# GRAPHXR_PROXY_ENGINES_DIR=~/.graphxr-proxy/engines

# Where the learned storage-format -> release map is kept. The shipped table is
# never written back, so a later build can still correct it.
# GRAPHXR_PROXY_ENGINE_MAP=config/engine_versions.json

# Where a store dropped onto a project is saved.
# GRAPHXR_PROXY_STORES_DIR=config/databases

# Ceiling on a dropped store, in bytes. Default 4 GiB.
# GRAPHXR_PROXY_MAX_UPLOAD_BYTES=4294967296

# How long an idle engine process is kept alive before it is shut down.
# GRAPHXR_PROXY_ENGINE_IDLE_SECONDS=300

# Path to uv, when it is not on PATH. Strongly recommended: without it the proxy
# can only install an engine for its own interpreter, and some releases publish no
# wheel for it (kuzu 0.11.3 has no CPython 3.14 wheel for Windows).
# GRAPHXR_PROXY_UV=/usr/local/bin/uv

# Wheels you built yourself. A wheel here is installed in preference to PyPI, which
# is how an engine with no wheel for this platform gets in at all -- LatticeDB
# publishes none for Windows. Also serves an air-gapped install.
# GRAPHXR_PROXY_WHEELHOUSE=~/.graphxr-proxy/wheelhouse
